# Copia este archivo como .env y ajusta los valores.
# Si NO defines DB_ENGINE=mysql, el proyecto usa SQLite automaticamente
# y funciona sin instalar nada mas.

SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Deja DB_ENGINE vacio o borralo para usar SQLite.
# Ponlo en "mysql" cuando tengas MySQL corriendo.
DB_ENGINE=
DB_NAME=ayuda_colombia
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
